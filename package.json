{
  "name": "testes-bugbank-cypress",
  "version": "1.0.0",
  "description": "projeto de testes da aplicação BugBank",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "test:chrome": "cypress run --browser chrome",
    "test:smoke": "cypress run --env tags=@smoke",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "allure:clean": "rimraf allure-results allure-report",
    "allure:generate": "allure generate allure-results -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:test": "npm run allure:clean && npm test && npm run allure:generate && npm run allure:open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entonymaxwell01/testes-bugbank-cypress.git"
  },
  "author": "Entony Maxwell",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/entonymaxwell01/testes-bugbank-cypress/issues"
  },
  "homepage": "https://github.com/entonymaxwell01/testes-bugbank-cypress#readme",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^24.19.2",
    "allure": "^3.33.0",
    "allure-cypress": "^3.15.0",
    "cypress": "^16.3.0",
    "cypress-on-fix": "^1.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-cypress": "^7.0.5",
    "prettier": "^3.10.1",
    "prettier-plugin-gherkin": "^4.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
